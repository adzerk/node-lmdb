{
  "name": "node-lmdb",
  "description": "Node binding for LMDB, the Lightning Memory-Mapped Database",
  "author": "Timur Kristóf <venemo@fedoraproject.org>",
  "contributors": [
    "Timur Kristóf",
    "Erich Ocean",
    "Braydon Fuller",
    "Andreas Holstenson (aholstenson)",
    "antoinevw",
    "b-ono",
    "da77a",
    "John Hewson (jahewson)",
    "Jeffrey Esquivel S. (jeffesquivels)",
    "Stefan Thomas (justmoon)",
    "Matt-Esch",
    "Oliver Zhou (oliverzy)",
    "Pascal Berrang (paberr)",
    "Raymond Neilson (rneilson)",
    "Kris Zyp (kriszyp)"
  ],
  "license": "MIT",
  "keywords": [
    "lmdb",
    "database",
    "mdb",
    "lightning",
    "binding"
  ],
  "repository": "https://github.com/Venemo/node-lmdb",
  "version": "0.10.1",
  "main": "./index.js",
  "scripts": {
    "install": "node-gyp-build",
    "recompile": "node-gyp build",
    "before-publish": "prebuildify-ci download && prebuildify -t 24.0.0 -t 22.0.0 -t 20.0.0 -t 18.0.0 -t 17.1.0 -t 16.13.0 -t 15.5.0 -t 14.17.6 -t 12.22.7 -t electron@15.2.0",
    "prebuild": "prebuildify -t 24.0.0 -t 22.0.0 -t 20.0.0 -t 18.0.0 -t 17.1.0 -t 16.13.0 -t 15.5.0 -t 14.17.6 -t 12.22.7 -t electron@15.2.0",
    "prebuild-linux-x64": "prebuildify-cross -i centos7-devtoolset7 -i alpine -t 24.0.0 -t 22.0.0 -t 20.0.0 -t 18.0.0 -t 17.1.0 -t 16.13.0 -t 15.5.0 -t 14.17.6 -t 12.22.7 -t electron@15.2.0",
    "prebuild-linux-arm64-glibc": "prebuildify-cross --tag-libc -i linux-arm64-lts -t 24.0.0 -t 22.0.0 -t 20.0.0 -t 18.0.0 -t 17.1.0 -t 16.13.0 -t 15.5.0 -t 14.17.6 -t 12.22.7 -t electron@15.2.0",
    "prebuild-linux-arm64-musl": "prebuildify-cross --libc musl --tag-libc -i linux-arm64-musl -t 24.0.0 -t 22.0.0 -t 20.0.0 -t 18.0.0 -t 17.1.0 -t 16.13.0 -t 15.5.0 -t 14.17.6 -t 12.22.7 -t electron@15.2.0",
    "test": "mocha test/**.test.js --recursive",
    "benchmark": "node ./benchmark/index.js"
  },
  "gypfile": true,
  "dependencies": {
    "msgpackr": "^1.11.0",
    "nan": "^2.25.0",
    "node-gyp-build": "^4.8.1"
  },
  "devDependencies": {
    "benchmark": "^2.1.4",
    "chai": "^4.2.0",
    "mkdirp": "^1.0.4",
    "mocha": "^8.1.3",
    "node-gyp": "^10.1.0",
    "prebuildify": "^6.0.1",
    "prebuildify-ci": "^1.0.5",
    "prebuildify-cross": "^5.0.0",
    "rimraf": "^3.0.2",
    "jshint": "^2.12.0"
  },
  "overrides": {
    "ajv": "^6.14.0",
    "ansi-regex": "^4.1.1",
    "bn.js": "^5.2.3",
    "asn1.js": {
      "bn.js": "^4.12.3"
    },
    "create-ecdh": {
      "bn.js": "^4.12.3"
    },
    "diffie-hellman": {
      "bn.js": "^4.12.3"
    },
    "elliptic": {
      ".": "^6.6.1",
      "bn.js": "^4.12.3"
    },
    "miller-rabin": {
      "bn.js": "^4.12.3"
    },
    "public-encrypt": {
      "bn.js": "^4.12.3"
    },
    "brace-expansion": "^1.1.18",
    "cacache": {
      "brace-expansion": "^2.1.4",
      "minimatch": "^9.0.7",
      "glob": "^10.5.0"
    },
    "node-gyp": {
      "brace-expansion": "^2.1.4",
      "minimatch": "^9.0.7",
      "glob": "^10.5.0"
    },
    "braces": "^3.0.3",
    "cipher-base": "^1.0.5",
    "cross-spawn": "^7.0.5",
    "debug": "^4.3.2",
    "diff": "^4.0.4",
    "form-data": "^2.5.6",
    "get-func-name": "^2.0.2",
    "glob-parent": "^5.1.2",
    "ip-address": "^10.3.1",
    "js-yaml": "^3.15.2",
    "json-schema": "^0.4.0",
    "lodash": "^4.17.23",
    "minimatch": "^3.1.4",
    "pathval": "^1.1.1",
    "pbkdf2": "^3.1.3",
    "picomatch": "^2.3.2",
    "qs": "^6.14.1",
    "serialize-javascript": "^7.0.3",
    "sha.js": "^2.4.12",
    "shell-quote": "^1.9.0",
    "shelljs": "^0.8.5",
    "tar": "^7.5.21",
    "tar-fs": "^2.1.4",
    "prebuildify-ci": {
      "tar-fs": "^1.16.6"
    },
    "uuid": "^11.1.1",
    "y18n": "^4.0.1"
  }
}
